{
  "name": "mubashir-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal academic and technology portfolio for Dr. Mubashir Hussain",
  "author": "Mubashir Hussain <mubashir.hussain@live.com>",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && pnpm pagefind",
    "build:no-search": "next build",
    "pagefind": "pagefind --site out --output-subdir _pagefind",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preflight": "tsx scripts/preflight.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,json,css}\"",
    "studio:dev": "cd studio && pnpm dev",
    "studio:build": "cd studio && pnpm build",
    "studio:deploy": "cd studio && pnpm deploy"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.1.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.460.0",
    "next": "16.2.6",
    "next-themes": "^0.4.4",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "tailwind-merge": "^2.5.5",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.13",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pagefind": "^1.3.0",
    "postcss": "^8.5.15",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "esbuild"
    ]
  }
}
